# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server HTTP/WebSocket port (defaults to 3000)
PORT="3000"

# IMB Payment Communications & OTP API (https://developer.imbpayment.in/api/communications.html)
# Configure IMB_CLIENT_ID and IMB_CLIENT_SECRET to dispatch live SMS & WhatsApp OTPs
IMB_BASE_URL="https://secure.imbpayment.in"
IMB_CLIENT_ID=""
IMB_CLIENT_SECRET=""
IMB_DEFAULT_OTP_CHANNEL="sms"

# ENABLE_IN_APP_OTP_PREVIEW: Set to "false" in production (defaults to off when IMB keys are configured)
ENABLE_IN_APP_OTP_PREVIEW="true"

# OTP_WEBHOOK_URL: Optional fallback SMS gateway webhook URL
OTP_WEBHOOK_URL=""
